categoryZh": "物品", "interrupt": false, "labelZh": "水井"}, {"id": "C15", "kind": "story", "categoryZh": "物品", "interrupt": true, "labelZh": "礼物"}, {"id": "C16", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "受到诅咒"}, {"id": "C17", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "中毒"}, {"id": "C18", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "会飞"}, {"id": "C19", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "会说话"}, {"id": "C20", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "微小"}, {"id": "C21", "kind": "story", "categoryZh": "特征", "interrupt": false, "labelZh": "邪恶"}, {"id": "C22", "kind": "story", "categoryZh": "特征", "interrupt": true, "labelZh": "遥远"}, {"id": "C23", "kind": "story", "categoryZh": "特征", "interrupt": true, "labelZh": "失散已久"}, {"id": "C24", "kind": "story", "categoryZh": "地点", "interrupt": false, "labelZh": "洞穴"}, {"id": "C25", "kind": "story", "categoryZh": "地点", "interrupt": false, "labelZh": "天空"}, {"id": "C26", "kind": "story", "categoryZh": "地点", "interrupt": false, "labelZh": "山"}, {"id": "C27", "kind": "story", "categoryZh": "地点", "interrupt": false, "labelZh": "夜晚"}, {"id": "C28", "kind": "story", "categoryZh": "地点", "interrupt": false, "labelZh": "沼泽"}, {"id": "C29", "kind": "story", "categoryZh": "地点", "interrupt": true, "labelZh": "王国"}, {"id": "C30", "kind": "story", "categoryZh": "地点", "interrupt": true, "labelZh": "废墟"}, {"id": "C31", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "仙子"}, {"id": "C32", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "巨人"}, {"id": "C33", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "狼"}, {"id": "C34", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "青蛙"}, {"id": "C35", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "马"}, {"id": "C36", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "怪物"}, {"id": "C37", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "龙"}, {"id": "C38", "kind": "story", "categoryZh": "角色", "interrupt": false, "labelZh": "女巫"}, {"id": "T1", "kind": "ending", "textZh": "从那以后，每逢第一场雪，村口都会多出一双归人的脚印。"}, {"id": "T2", "kind": "ending", "textZh": "她把最后一把钥匙留在门外，好让后来的人也能回家。"}, {"id": "T3", "kind": "ending", "textZh": "加冕那天，他把王冠戴在了当初收留他的那个人头上。"}, {"id": "T4", "kind": "ending", "textZh": "他们把旧地图裁成船帆，向地图边缘以外驶去。"}, {"id": "T5", "kind": "ending", "textZh": "从此，谁在井边说一句真心话，水面便亮起一颗星。"}, {"id": "T6", "kind": "ending", "textZh": "她终于听懂了那首摇篮曲，也认出了唱歌的人。"}, {"id": "T7", "kind": "ending", "textZh": "敲过第十三下钟，他们才发现天已经亮了。"}, {"id": "T8", "kind": "ending", "textZh": "他把许下的最后一个愿望，送给了素不相识的孩子。"}, {"id": "T9", "kind": "ending", "textZh": "等她走过桥，身后的每一级台阶都开出了花。"}, {"id": "T10", "kind": "ending", "textZh": "他们谁也没有带走金币，却都觉得这一趟值得。"}, {"id": "T11", "kind": "ending", "textZh": "于是，城门从此多了一条规矩：先请远客坐下来吃饭。"}, {"id": "T12", "kind": "ending", "textZh": "隔年春天，那封没有署名的信终于等来了回信。"}, {"id": "T13", "kind": "ending", "textZh": "她在空白的那一页写下了自己的名字，这本书便合上了。"}, {"id": "T14", "kind": "ending", "textZh": "第二天，面包房照常开门，门上却挂着王宫的钥匙。"}, {"id": "T15", "kind": "ending", "textZh": "最后那盏灯始终亮着，因为他们知道还有一人要回来。"}, {"id": "T16", "kind": "ending", "textZh": "他摘下借来的面具，台下仍有人第一个为他鼓掌。"}, {"id": "T17", "kind": "ending", "textZh": "就这样，两个世代为敌的村子合办了第一场集市。"}, {"id": "T18", "kind": "ending", "textZh": "从那以后，连最小的孩子也有权向国王提一个问题。"}, {"id": "T19", "kind": "ending", "textZh": "他们把秘密埋在树下，来年那里结出了铃铛。"}, {"id": "T20", "kind": "ending", "textZh": "她推开那扇一直害怕的门，门里的人已经为她摆好了碗筷。"}, {"id": "T21", "kind": "ending", "textZh": "等钟匠修好最后一根发条，城里的每个人都找回了丢失的那一天。"}, {"id": "T22", "kind": "ending", "textZh": "他把自己的座位让给老人，没想到那正是最后一道考验。"}, {"id": "T23", "kind": "ending", "textZh": "等最后一片雾散去，他们才看见对岸也有人等了整整一夜。"}, {"id": "T24", "kind": "ending", "textZh": "那条无人敢走的小道，如今每天都有孩子结伴去上学。"}]}